<div id="help">
  <div class="card">
    <h3>단축키</h3>
    <div class="kk"><span>다음 / 이전 슬라이드</span><span><kbd>→</kbd> <kbd>←</kbd></span></div>
    <div class="kk"><span>다음 슬라이드</span><span><kbd>Space</kbd></span></div>
    <div class="kk"><span>발표자 노트 (시간 배분)</span><span><kbd>N</kbd></span></div>
    <div class="kk"><span>전체화면</span><span><kbd>F</kbd></span></div>
    <div class="kk"><span>모든 소리 정지</span><span><kbd>S</kbd></span></div>
    <div class="kk"><span>처음 / 끝으로</span><span><kbd>Home</kbd> <kbd>End</kbd></span></div>
    <div class="kk" style="border:none"><span>이 창 닫기</span><span><kbd>?</kbd> <kbd>Esc</kbd></span></div>
  </div>
</div>

<script>
/* =========================================================================
   푸리에 해석 · 소리를 숫자로 듣다  —  interaction / audio / visualization
   ========================================================================= */
(function(){
"use strict";

/* collected static-draw callbacks (run on boot and on resize) */
const drawInit=[];

/* ---------- spectral colormap (frequency → color) ---------- */
const STOPS=[[0,[124,108,240]],[.16,[77,124,255]],[.33,[34,211,238]],
             [.5,[45,212,167]],[.66,[163,230,53]],[.82,[250,204,21]],[1,[251,113,133]]];
function clamp(v,a,b){return v<a?a:v>b?b:v;}
function specRGB(u){
  u=clamp(u,0,1);
  for(let i=0;i<STOPS.length-1;i++){
    if(u<=STOPS[i+1][0]){
      const t=(u-STOPS[i][0])/(STOPS[i+1][0]-STOPS[i][0]||1);
      const a=STOPS[i][1],b=STOPS[i+1][1];
      return [Math.round(a[0]+(b[0]-a[0])*t),Math.round(a[1]+(b[1]-a[1])*t),Math.round(a[2]+(b[2]-a[2])*t)];
    }
  }
  return STOPS[STOPS.length-1][1];
}
function specColor(u,al){const c=specRGB(u);return `rgba(${c[0]},${c[1]},${c[2]},${al==null?1:al})`;}

/* ---------- canvas fit (dpr-aware; raw mode for scrolling spectrogram) ---------- */
const REDUCED = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
function fit(cv,raw){
  if(!cv) return;
  const dpr = raw?1:Math.min(window.devicePixelRatio||1,2);
  const cssH = parseInt(cv.getAttribute('height'))||150;
  cv.style.height = cssH+'px';
  const cssW = cv.clientWidth || (cv.parentElement?cv.parentElement.clientWidth:600) || 600;
  cv.width = Math.max(1,Math.round(cssW*dpr));
  cv.height = Math.max(1,Math.round(cssH*dpr));
  const ctx = cv.getContext('2d');
  if(raw){ctx.setTransform(1,0,0,1,0,0);} else {ctx.setTransform(dpr,0,0,dpr,0,0);}
  cv._w=raw?cv.width:cssW; cv._h=raw?cv.height:cssH; cv._ctx=ctx; cv._raw=!!raw;
}
function grid(ctx,w,h){
  ctx.save();
  ctx.strokeStyle='rgba(255,255,255,0.045)'; ctx.lineWidth=1;
  ctx.beginPath();
  for(let i=1;i<8;i++){const x=Math.round(w*i/8)+.5;ctx.moveTo(x,0);ctx.lineTo(x,h);}
  for(let j=1;j<4;j++){const y=Math.round(h*j/4)+.5;ctx.moveTo(0,y);ctx.lineTo(w,y);}
  ctx.stroke();
  ctx.strokeStyle='rgba(255,255,255,0.11)';
  ctx.beginPath(); ctx.moveTo(0,Math.round(h/2)+.5); ctx.lineTo(w,Math.round(h/2)+.5); ctx.stroke();
  ctx.restore();
}

/* ---------- generic waveform draw ---------- */
function drawWave(cv,fn,opts){
  if(!cv||!cv._ctx) return; opts=opts||{};
  const ctx=cv._ctx,w=cv._w,h=cv._h;
  ctx.clearRect(0,0,w,h); grid(ctx,w,h);
  const mid=h/2, amp=(h/2-14)*(opts.scale||1);
  if(opts.ref){ // faint reference outline (e.g. ideal square)
    ctx.strokeStyle='rgba(255,255,255,0.16)'; ctx.lineWidth=1.4; ctx.setLineDash([5,5]); ctx.beginPath();
    const N=600; for(let i=0;i<=N;i++){const x=i/N;ctx.lineTo(x*w,mid-clamp(opts.ref(x),-1,1)*amp);} ctx.stroke(); ctx.setLineDash([]);
  }
  const grad=ctx.createLinearGradient(0,0,w,0);
  grad.addColorStop(0,opts.c0||'#22D3EE'); grad.addColorStop(1,opts.c1||'#2DD4A7');
  ctx.strokeStyle=grad; ctx.lineWidth=opts.lw||2.6; ctx.lineJoin='round';
  ctx.shadowColor=opts.glow||'#22D3EE'; ctx.shadowBlur=opts.blur==null?9:opts.blur;
  ctx.beginPath();
  const N=Math.max(360,Math.floor(w));
  for(let i=0;i<=N;i++){const x=i/N;const y=fn(x);ctx.lineTo(x*w,mid-y*amp);}
  ctx.stroke(); ctx.shadowBlur=0;
}

/* ---------- spectrum bars (colored by harmonic index / frequency) ---------- */
function drawBars(cv,amps,opts){
  if(!cv||!cv._ctx) return; opts=opts||{};
  const ctx=cv._ctx,w=cv._w,h=cv._h;
  ctx.clearRect(0,0,w,h);
  const n=amps.length, pad=10, base=h-22;
  let mx=0; for(let i=0;i<n;i++) mx=Math.max(mx,amps[i]); if(mx<=0)mx=1;
  const slot=(w-pad*2)/n, bw=Math.min(slot*0.62,26);
  // baseline
  ctx.strokeStyle='rgba(255,255,255,0.12)'; ctx.beginPath(); ctx.moveTo(pad,base+.5); ctx.lineTo(w-pad,base+.5); ctx.stroke();
  ctx.font='10px "JetBrains Mono",monospace'; ctx.textAlign='center';
  for(let i=0;i<n;i++){
    const u=n>1?i/(n-1):0, c=specRGB(u);
    const x=pad+slot*i+slot/2, bh=(amps[i]/mx)*(base-12);
    const col=`rgb(${c[0]},${c[1]},${c[2]})`;
    if(opts.ghost && opts.ghost[i]){ // dropped/inaudible component
      ctx.fillStyle='rgba(255,255,255,0.10)';
      ctx.fillRect(x-bw/2,base-bh,bw,bh);
      ctx.fillStyle='rgba(255,255,255,0.22)';
    } else {
      ctx.shadowColor=col; ctx.shadowBlur=10;
      ctx.fillStyle=col; roundRectTop(ctx,x-bw/2,base-bh,bw,bh,3); ctx.fill(); ctx.shadowBlur=0;
    }
    ctx.fillStyle=opts.ghost&&opts.ghost[i]?'rgba(255,255,255,0.25)':'rgba(255,255,255,0.4)';
    ctx.fillText(opts.labels?opts.labels[i]:(i+1), x, base+14);
  }
}
function roundRectTop(ctx,x,y,w,h,r){
  r=Math.min(r,w/2,h); if(h<=0){return;}
  ctx.beginPath();
  ctx.moveTo(x,y+h); ctx.lineTo(x,y+r); ctx.quadraticCurveTo(x,y,x+r,y);
  ctx.lineTo(x+w-r,y); ctx.quadraticCurveTo(x+w,y,x+w,y+r); ctx.lineTo(x+w,y+h); ctx.closePath();
}

/* ============================ AUDIO ENGINE ============================ */
const AU={ctx:null,master:null,voices:new Set()};
function ac(){
  if(!AU.ctx){
    const C=window.AudioContext||window.webkitAudioContext;
    AU.ctx=new C(); AU.master=AU.ctx.createGain(); AU.master.gain.value=0.85; AU.master.connect(AU.ctx.destination);
  }
  if(AU.ctx.state==='suspended') AU.ctx.resume();
  return AU.ctx;
}
function periodicWave(amps){ // sine-only harmonics; normalized
  const ctx=ac(), n=amps.length+1;
  const real=new Float32Array(n), imag=new Float32Array(n);
  for(let i=0;i<amps.length;i++) imag[i+1]=amps[i];
  return ctx.createPeriodicWave(real,imag,{disableNormalization:false});
}
function tone(cfg){
  cfg=cfg||{}; const ctx=ac();
  const o=ctx.createOscillator(), g=ctx.createGain();
  if(cfg.wave) o.setPeriodicWave(cfg.wave); else o.type=cfg.type||'sine';
  o.frequency.value=cfg.freq||220;
  o.connect(g); g.connect(cfg.dest||AU.master);
  g.gain.value=0; o.start();
  g.gain.setTargetAtTime(cfg.vol==null?0.2:cfg.vol, ctx.currentTime, 0.012);
  const v={o,g,stop(){const t=ctx.currentTime; try{g.gain.cancelScheduledValues(t);g.gain.setTargetAtTime(0.0001,t,0.02);o.stop(t+0.14);}catch(e){} AU.voices.delete(v);}};
  AU.voices.add(v); return v;
}
function stopAll(){ AU.voices.forEach(v=>{try{v.stop&&v.stop();}catch(e){}}); AU.voices.clear(); saStop(); sgStop(); }

/* note name from frequency */
const NOTE=['도(C)','도#','레(D)','레#','미(E)','파(F)','파#','솔(G)','솔#','라(A)','라#','시(B)'];
function noteName(f){
  const n=Math.round(12*Math.log2(f/440))+9; // A4 index 9
  const name=NOTE[((n%12)+12)%12]; const oct=4+Math.floor((n-9)/12);
  return name+oct;
}

/* ========================= INSTRUMENT / PRESET RECIPES ========================= */
const RECIPES={
  sine:[1,0,0,0,0,0,0,0],
  square:[1,0,1/3,0,1/5,0,1/7,0].map(v=>v),
  saw:[1,1/2,1/3,1/4,1/5,1/6,1/7,1/8],
  organ:[1,0.5,0.85,0.2,0.55,0.1,0.3,0.08],
  clarinet:[1,0.04,0.62,0.05,0.42,0.05,0.26,0.04],
  pure:[1,0,0,0,0,0,0,0],
  reed:[1,0.6,0.85,0.45,0.6,0.3,0.4,0.22]
};
const INST={
  flute:[1,0.28,0.12,0.06,0.03,0.02,0.015,0.01,0.008,0.006],
  clarinet:[1,0.05,0.65,0.06,0.42,0.05,0.27,0.04,0.16,0.03],
  violin:[1,0.62,0.72,0.5,0.46,0.4,0.31,0.27,0.2,0.17],
  brass:[0.55,0.9,1.0,0.86,0.7,0.6,0.5,0.4,0.31,0.24]
};

/* ============================ SLIDE CONTROLLER ============================ */
const slides=[].slice.call(document.querySelectorAll('.slide'));
const total=slides.length;
let cur=0;
const ENTERS={};     // data-enter key -> () => stopFn
let activeStops=[];

const elProg=document.getElementById('progress');
const elCounter=document.getElementById('counter');
const elHudCh=document.getElementById('hud-ch');

function pad2(n){return (n<10?'0':'')+n;}
function show(i){
  i=clamp(i,0,total-1);
  // leave current
  activeStops.forEach(fn=>{try{fn&&fn();}catch(e){}}); activeStops=[];
  stopAll(); resetToggles();
  slides[cur].classList.remove('active'); slides[cur].classList.add('prev');
  cur=i;
  slides.forEach((s,k)=>{ if(k!==cur) s.classList.remove('active'); });
  slides[cur].classList.remove('prev'); slides[cur].classList.add('active');
  // chrome
  elProg.style.width=(total>1?(cur/(total-1))*100:0)+'%';
  elCounter.textContent=pad2(cur+1)+' / '+pad2(total);
  elHudCh.textContent=slides[cur].getAttribute('data-ch')||'';
  if(notesOpen) renderNotes();
  // enter
  const ekey=slides[cur].getAttribute('data-enter');
  if(ekey && ENTERS[ekey]){ const stop=ENTERS[ekey](); if(stop) activeStops.push(stop); }
}
function next(){ if(cur<total-1) show(cur+1); }
function prev(){ if(cur>0) show(cur-1); }

/* toggle button bookkeeping */
const toggleBtns=[]; // {el,onLabel,offLabel,state}
function regToggle(el,onLabel,offLabel){ if(!el)return null; const t={el,onLabel,offLabel,state:false}; toggleBtns.push(t); return t; }
function setToggle(t,on){ if(!t)return; t.state=on; t.el.classList.toggle('on',on); t.el.textContent=on?t.onLabel:t.offLabel; }
function resetToggles(){ toggleBtns.forEach(t=>setToggle(t,false)); document.querySelectorAll('.btn.on').forEach(b=>b.classList.remove('on')); }

/* ============================ CHROME WIRING ============================ */
document.getElementById('next').onclick=next;
document.getElementById('prev').onclick=prev;
document.getElementById('stopbtn').onclick=stopAll;

const helpEl=document.getElementById('help');
document.getElementById('kbtn').onclick=()=>helpEl.classList.toggle('show');
helpEl.onclick=e=>{ if(e.target===helpEl) helpEl.classList.remove('show'); };

document.getElementById('fsbtn').onclick=toggleFS;
function toggleFS(){ if(!document.fullscreenElement){document.documentElement.requestFullscreen&&document.documentElement.requestFullscreen();} else {document.exitFullscreen&&document.exitFullscreen();} }

let notesOpen=false;
const notesEl=document.getElementById('notes');
document.getElementById('notebtn').onclick=toggleNotes;
function toggleNotes(){ notesOpen=!notesOpen; notesEl.classList.toggle('show',notesOpen); if(notesOpen) renderNotes(); }
function cumMin(idx){ let s=0; for(let k=0;k<=idx;k++){ s+=parseFloat(slides[k].getAttribute('data-min'))||0; } return s; }
function totalMin(){ return cumMin(total-1); }
function renderNotes(){
  const s=slides[cur];
  document.getElementById('nt-ch').textContent=s.getAttribute('data-ch')||'';
  const m=parseFloat(s.getAttribute('data-min'))||0;
  document.getElementById('nt-title').textContent='슬라이드 '+(cur+1)+' · 약 '+(m%1?m.toFixed(1):m)+'분';
  document.getElementById('nt-time').textContent='누적 '+Math.round(cumMin(cur))+'분 / 총 '+Math.round(totalMin())+'분';
  document.getElementById('nt-body').textContent=s.getAttribute('data-notes')||'(노트 없음)';
}

document.addEventListener('keydown',e=>{
  if(e.key==='ArrowRight'||e.key==='PageDown'){e.preventDefault();next();}
  else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();prev();}
  else if(e.key===' '){e.preventDefault();next();}
  else if(e.key==='Home'){e.preventDefault();show(0);}
  else if(e.key==='End'){e.preventDefault();show(total-1);}
  else if(e.key==='n'||e.key==='N'){toggleNotes();}
  else if(e.key==='f'||e.key==='F'){toggleFS();}
  else if(e.key==='s'||e.key==='S'){stopAll();}
  else if(e.key==='?'){helpEl.classList.toggle('show');}
  else if(e.key==='Escape'){helpEl.classList.remove('show'); if(notesOpen)toggleNotes();}
});

/* swipe on touch */
let tx=0;
document.addEventListener('touchstart',e=>{tx=e.changedTouches[0].clientX;},{passive:true});
document.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-tx; if(Math.abs(dx)>60){dx<0?next():prev();}},{passive:true});

/* ============================ DEMOS ============================ */

/* --- 0 & 35 : ambient oscilloscope --- */
function ambient(id){
  const cv=document.getElementById(id); if(!cv) return ()=>{};
  let t=0, raf=0, run=true;
  function draw(){
    const ctx=cv._ctx,w=cv._w,h=cv._h; if(!ctx)return;
    ctx.clearRect(0,0,w,h); grid(ctx,w,h);
    const mid=h/2;
    const grad=ctx.createLinearGradient(0,0,w,0);
    grad.addColorStop(0,'#7C6CF0'); grad.addColorStop(.5,'#22D3EE'); grad.addColorStop(1,'#2DD4A7');
    ctx.strokeStyle=grad; ctx.lineWidth=2.6; ctx.lineJoin='round';
    ctx.shadowColor='#22D3EE'; ctx.shadowBlur=14; ctx.beginPath();
    const N=Math.max(360,w);
    for(let i=0;i<=N;i++){const x=i/N;
      const y=0.5*Math.sin(2*Math.PI*2*x+t)+0.28*Math.sin(2*Math.PI*3*x+t*1.3)+0.16*Math.sin(2*Math.PI*5*x+t*0.7);
      ctx.lineTo(x*w,mid-y*(h/2-16));}
    ctx.stroke(); ctx.shadowBlur=0;
  }
  if(REDUCED){ draw(); return ()=>{}; }
  function frame(){ if(!run)return; draw(); t+=0.028; raf=requestAnimationFrame(frame); }
  frame();
  return ()=>{run=false; cancelAnimationFrame(raf);};
}
ENTERS.hero=()=>ambient('heroCanvas');
ENTERS.end=()=>ambient('endCanvas');

/* --- 1 : hook (three timbres) --- */
(function(){
  const cv=document.getElementById('hookWave');
  function drawTimbre(key){
    const r=RECIPES[key]||RECIPES.pure;
    drawWave(cv,x=>{let s=0,sum=0;for(let k=0;k<r.length;k++){s+=r[k]*Math.sin(2*Math.PI*(k+1)*2*x);sum+=Math.abs(r[k]);}return s/Math.max(1,sum*0.8);},{c0:'#7C6CF0',c1:'#22D3EE',glow:'#7C6CF0'});
  }
  document.querySelectorAll('[data-timbre]').forEach(b=>{
    b.addEventListener('click',()=>{
      stopAll(); const key=b.getAttribute('data-timbre');
      drawTimbre(key);
      tone({wave:periodicWave(RECIPES[key]),freq:440,vol:0.24});
    });
  });
  drawInit.push(()=>drawTimbre('pure'));
})();

/* --- 4 : pressure waveform (decorative but real) --- */
(function(){
  const cv=document.getElementById('pressureWave');
  const r=[1,0.5,0.32,0.18,0.12,0.07];
  drawInit.push(()=>drawWave(cv,x=>{let s=0,sum=0;for(let k=0;k<r.length;k++){s+=r[k]*Math.sin(2*Math.PI*(k+1)*2*x+k*0.6);sum+=r[k];}return s/(sum*0.9);},{c0:'#7C6CF0',c1:'#4D7CFF',glow:'#4D7CFF'}));
})();

/* --- 5 : pure tone --- */
(function(){
  const cv=document.getElementById('pt-wave');
  const fEl=document.getElementById('pt-freq'),aEl=document.getElementById('pt-amp');
  const fR=document.getElementById('pt-freq-r'),aR=document.getElementById('pt-amp-r'),noteR=document.getElementById('pt-note');
  const playBtn=document.getElementById('pt-play'); const tg=regToggle(playBtn,'■ 정지','▶ 재생');
  let voice=null;
  function freq(){return +fEl.value;} function amp(){return +aEl.value/100;}
  function draw(){
    const cycles=Math.max(1.5,(freq()/110)*1.2);
    drawWave(cv,x=>amp()*Math.sin(2*Math.PI*cycles*x),{c0:'#7C6CF0',c1:'#22D3EE',glow:'#7C6CF0',scale:0.95});
  }
  function upd(){fR.textContent=freq()+' Hz'; aR.textContent=amp().toFixed(2); noteR.textContent='— '+noteName(freq()); draw(); if(voice){voice.o.frequency.setTargetAtTime(freq(),AU.ctx.currentTime,0.02); voice.g.gain.setTargetAtTime(amp()*0.4,AU.ctx.currentTime,0.02);}}
  fEl.addEventListener('input',upd); aEl.addEventListener('input',upd);
  playBtn.addEventListener('click',()=>{
    if(tg.state){ if(voice){voice.stop();voice=null;} setToggle(tg,false); }
    else { if(voice){try{voice.stop();}catch(e){}} voice=tone({type:'sine',freq:freq(),vol:amp()*0.4}); setToggle(tg,true); voice.o.onended=()=>{voice=null;setToggle(tg,false);}; }
  });
  drawInit.push(upd);
})();

/* --- 7 : octave / intervals --- */
(function(){
  const cv=document.getElementById('oct-wave');
  function drawSet(kind){
    let fn;
    if(kind==='220') fn=x=>Math.sin(2*Math.PI*2*x);
    else if(kind==='440') fn=x=>Math.sin(2*Math.PI*4*x);
    else if(kind==='660') fn=x=>Math.sin(2*Math.PI*6*x);
    else fn=x=>(Math.sin(2*Math.PI*2*x)+Math.sin(2*Math.PI*4*x)+Math.sin(2*Math.PI*6*x))/3;
    drawWave(cv,fn,{c0:'#7C6CF0',c1:'#2DD4A7',glow:'#7C6CF0',scale:0.9});
  }
  document.querySelectorAll('[data-int]').forEach(b=>{
    b.addEventListener('click',()=>{
      stopAll(); const k=b.getAttribute('data-int'); drawSet(k);
      if(k==='chord'){[220,440,660].forEach(f=>tone({type:'sine',freq:f,vol:0.16}));}
      else tone({type:'sine',freq:+k,vol:0.22});
    });
  });
  drawInit.push(()=>drawSet('440'));
})();

/* --- 9 : add two --- */
(function(){
  const cv=document.getElementById('add-wave');
  function draw(kind){
    let fn;
    if(kind==='f') fn=x=>Math.sin(2*Math.PI*4*x);
    else if(kind==='g') fn=x=>Math.sin(2*Math.PI*6*x);
    else fn=x=>(Math.sin(2*Math.PI*4*x)+Math.sin(2*Math.PI*6*x))/2;
    drawWave(cv,fn,{c0:'#4D7CFF',c1:'#22D3EE',glow:'#4D7CFF',scale:0.92});
  }
  document.querySelectorAll('[data-add]').forEach(b=>{
    b.addEventListener('click',()=>{
      stopAll(); const k=b.getAttribute('data-add'); draw(k);
      if(k==='f') tone({type:'sine',freq:440,vol:0.22});
      else if(k==='g') tone({type:'sine',freq:660,vol:0.22});
      else {tone({type:'sine',freq:440,vol:0.18});tone({type:'sine',freq:660,vol:0.18});}
    });
  });
  drawInit.push(()=>draw('sum'));
})();

/* --- BEATS : sum-to-product (맥놀이) --- */
(function(){
  const cv=document.getElementById('beat-wave');
  const dEl=document.getElementById('beat-d'),dR=document.getElementById('beat-d-r');
  const avgR=document.getElementById('beat-avg'),beatR=document.getElementById('beat-rate');
  const playBtn=document.getElementById('beat-play'),tuneBtn=document.getElementById('beat-tune');
  const base=440; let v1=null,v2=null,override=null,tuneRaf=0;
  const tg=regToggle(playBtn,'■ 정지','▶ 두 음 재생');
  function df(){ return override!=null?override:+dEl.value; }
  function f1(){return base;} function f2(){return base+df();}
  function draw(){
    if(!cv||!cv._ctx) return;
    const ctx=cv._ctx,w=cv._w,h=cv._h;
    const d=df(), b=Math.max(0.0001,Math.min(6,d*0.5)), Cc=8+b*14;
    ctx.clearRect(0,0,w,h); grid(ctx,w,h);
    const mid=h/2, amp=h/2-16, N=Math.max(440,w);
    const env=x=>Math.abs(Math.cos(2*Math.PI*(b/2)*x));
    // envelope fill (amber, "breathing" band)
    ctx.beginPath();
    for(let i=0;i<=N;i++){const x=i/N;ctx.lineTo(x*w,mid-env(x)*amp);}
    for(let i=N;i>=0;i--){const x=i/N;ctx.lineTo(x*w,mid+env(x)*amp);}
    ctx.closePath(); ctx.fillStyle='rgba(250,204,21,0.09)'; ctx.fill();
    // envelope outlines (dashed amber)
    ctx.strokeStyle='rgba(250,204,21,0.5)'; ctx.lineWidth=1.5; ctx.setLineDash([5,4]);
    ctx.beginPath(); for(let i=0;i<=N;i++){const x=i/N;ctx.lineTo(x*w,mid-env(x)*amp);} ctx.stroke();
    ctx.beginPath(); for(let i=0;i<=N;i++){const x=i/N;ctx.lineTo(x*w,mid+env(x)*amp);} ctx.stroke();
    ctx.setLineDash([]);
    // carrier inside envelope (cyan glow)
    const grad=ctx.createLinearGradient(0,0,w,0); grad.addColorStop(0,'#4D7CFF'); grad.addColorStop(1,'#22D3EE');
    ctx.strokeStyle=grad; ctx.lineWidth=2; ctx.shadowColor='#22D3EE'; ctx.shadowBlur=8; ctx.beginPath();
    for(let i=0;i<=N;i++){const x=i/N;const e=Math.cos(2*Math.PI*(b/2)*x);const c=Math.sin(2*Math.PI*Cc*x);ctx.lineTo(x*w,mid-e*c*amp);}
    ctx.stroke(); ctx.shadowBlur=0;
  }
  function readouts(){ const d=df(); if(dR)dR.textContent=d.toFixed(1)+' Hz';
    if(avgR) avgR.textContent=((f1()+f2())/2).toFixed(0)+' Hz';
    if(beatR) beatR.textContent=d<0.05?'없음 · 완전 일치':(d.toFixed(1)+' Hz');
  }
  function live(){ try{const t=AU.ctx?AU.ctx.currentTime:0; if(v1)v1.o.frequency.setTargetAtTime(f1(),t,0.03); if(v2)v2.o.frequency.setTargetAtTime(f2(),t,0.03);}catch(e){} }
  function update(){ readouts(); draw(); live(); }
  if(dEl) dEl.addEventListener('input',()=>{ override=null; cancelAnimationFrame(tuneRaf); update(); });
  if(playBtn) playBtn.addEventListener('click',()=>{
    if(tg.state){ if(v1){try{v1.stop();}catch(e){}} if(v2){try{v2.stop();}catch(e){}} v1=v2=null; setToggle(tg,false); }
    else { if(v1){try{v1.stop();}catch(e){}} if(v2){try{v2.stop();}catch(e){}}
      v1=tone({type:'sine',freq:f1(),vol:0.18}); v2=tone({type:'sine',freq:f2(),vol:0.18}); setToggle(tg,true); }
  });
  if(tuneBtn) tuneBtn.addEventListener('click',()=>{
    cancelAnimationFrame(tuneRaf);
    if(!tg.state){ v1=tone({type:'sine',freq:f1(),vol:0.18}); v2=tone({type:'sine',freq:f2(),vol:0.18}); setToggle(tg,true); }
    const from=Math.max(6,(+dEl.value)||6), start=performance.now(), dur=6500;
    (function step(now){
      if(!tg.state){ override=null; return; }          // stop if user navigated away
      const t=Math.min(1,(now-start)/dur);
      override=from*(1-t)*(1-t);                         // ease-out: lingers near zero
      if(dEl) dEl.value=override.toFixed(1);
      update();
      if(t<1){ tuneRaf=requestAnimationFrame(step); } else { override=null; }
    })(start);
  });
  drawInit.push(()=>{ override=null; update(); });
})();

/* --- harmonic-builder factory (used by 11 and 34) --- */
function makeBuilder(opt){
  const cont=document.getElementById(opt.sliders);
  const waveCv=document.getElementById(opt.wave), specCv=document.getElementById(opt.spec);
  const playBtn=document.getElementById(opt.play);
  const N=8; let amps=new Array(N).fill(0); amps[0]=1;
  // build sliders
  let html='';
  for(let k=0;k<N;k++) html+=`<div class="hsl"><input type="range" min="0" max="100" value="${k===0?100:0}" data-h="${k}"><span class="lab">${k+1}</span></div>`;
  cont.innerHTML=html;
  const inputs=[].slice.call(cont.querySelectorAll('input'));
  let voice=null; const tg=regToggle(playBtn,'■ 정지',opt.playLabel||'▶ 재생');
  function read(){ for(let k=0;k<N;k++) amps[k]=inputs[k].value/100; }
  function draw(){
    drawWave(waveCv,x=>{let s=0,sum=0;for(let k=0;k<N;k++){s+=amps[k]*Math.sin(2*Math.PI*(k+1)*2*x);sum+=Math.abs(amps[k]);}return s/Math.max(0.8,sum*0.85);},{c0:opt.c0||'#4D7CFF',c1:opt.c1||'#22D3EE',glow:opt.glow||'#4D7CFF',scale:0.95});
    drawBars(specCv,amps.slice());
  }
  function live(){ if(voice){ try{voice.o.setPeriodicWave(periodicWave(amps));}catch(e){} } }
  function update(){ read(); draw(); live(); }
  inputs.forEach(inp=>inp.addEventListener('input',update));
  if(playBtn) playBtn.addEventListener('click',()=>{
    if(tg.state){ if(voice){voice.stop();voice=null;} setToggle(tg,false); }
    else { if(voice){try{voice.stop();}catch(e){}} read(); voice=tone({wave:periodicWave(amps),freq:opt.freq||220,vol:0.26}); setToggle(tg,true); voice.o.onended=()=>{voice=null;setToggle(tg,false);}; }
  });
  function setPreset(arr){ inputs.forEach((inp,k)=>inp.value=Math.round((arr[k]||0)*100)); update(); }
  return {update,setPreset,inputs,draw};
}
let HB=null, SB=null;
(function(){
  HB=makeBuilder({sliders:'hb-sliders',wave:'hb-wave',spec:'hb-spec',play:'hb-play',freq:220,playLabel:'▶ 재생 (f₀ = 220 Hz)'});
  const chips=document.querySelectorAll('#hb-presets .chip');
  chips.forEach(c=>c.addEventListener('click',()=>{
    chips.forEach(x=>x.classList.remove('on')); c.classList.add('on');
    const r=RECIPES[c.getAttribute('data-preset')]||RECIPES.sine;
    HB.setPreset(r.map(v=>Math.min(1,v)));
  }));
  drawInit.push(()=>HB.update());
})();

/* --- 12 : square-wave convergence --- */
(function(){
  const cv=document.getElementById('sq-wave');
  const nEl=document.getElementById('sq-n'),nR=document.getElementById('sq-n-r'),tag=document.getElementById('sq-tag');
  const playBtn=document.getElementById('sq-play'),animBtn=document.getElementById('sq-anim');
  const tg=regToggle(playBtn,'■ 정지','▶ 현재 N 듣기');
  let voice=null, animRaf=0;
  function partial(x,N){ let s=0; for(let k=1;k<=N;k+=2){ s+=(1/k)*Math.sin(2*Math.PI*k*1.5*x); } return (4/Math.PI)*s; }
  function squareRef(x){ return Math.sin(2*Math.PI*1.5*x)>=0?0.92:-0.92; }
  function draw(N){
    nR.textContent=N; tag.textContent='N = '+N+' harmonic'+(N>1?'s':'');
    drawWave(cv,x=>partial(x,N)*0.82,{c0:'#4D7CFF',c1:'#22D3EE',glow:'#4D7CFF',ref:squareRef});
  }
  function squareAmps(N){ const a=new Array(N+1).fill(0); for(let k=1;k<=N;k+=2)a[k]=1/k; return a; }
  nEl.addEventListener('input',()=>{cancelAnimationFrame(animRaf);draw(+nEl.value);});
  playBtn.addEventListener('click',()=>{
    if(tg.state){ if(voice){voice.stop();voice=null;} setToggle(tg,false); }
    else { if(voice){try{voice.stop();}catch(e){}} voice=tone({wave:periodicWave(squareAmps(+nEl.value)),freq:160,vol:0.24}); setToggle(tg,true); voice.o.onended=()=>{voice=null;setToggle(tg,false);}; }
  });
  animBtn.addEventListener('click',()=>{
    cancelAnimationFrame(animRaf); let N=1; nEl.value=1; draw(1);
    let last=performance.now();
    (function step(now){ if(now-last>260){ N=Math.min(49,N+2); nEl.value=N; draw(N); last=now; if(N>=49)return; } animRaf=requestAnimationFrame(step); })(last);
  });
  drawInit.push(()=>draw(1));
})();

/* --- 13 : waveform gallery --- */
(function(){
  const cv=document.getElementById('wf-wave'),tag=document.getElementById('wf-tag');
  const fEl=document.getElementById('wf-formula'),dEl=document.getElementById('wf-desc');
  const NH=31;
  function val(type,x){
    const th=2*Math.PI*1.5*x; let s=0;
    if(type==='sine') return Math.sin(th);
    if(type==='square'){for(let k=1;k<=NH;k+=2)s+=Math.sin(k*th)/k;return (4/Math.PI)*s*0.82;}
    if(type==='saw'){for(let k=1;k<=NH;k++)s+=(k%2?1:-1)*Math.sin(k*th)/k;return (2/Math.PI)*s*0.85;}
    if(type==='triangle'){for(let k=1;k<=NH;k+=2){s+=(((k-1)/2)%2?-1:1)*Math.sin(k*th)/(k*k);}return (8/(Math.PI*Math.PI))*s;}
    return 0;
  }
  const META={
    sine:{f:'$$y=\\sin\\theta$$',d:'배음 하나뿐 — 가장 순수한 소리'},
    square:{f:'$$\\tfrac{4}{\\pi}\\sum_{k\\,odd}\\tfrac{1}{k}\\sin k\\theta$$',d:'홀수 배음만 · 1/k로 감소 — 속 빈 듯한 소리'},
    saw:{f:'$$\\tfrac{2}{\\pi}\\sum_{k}\\tfrac{(-1)^{k+1}}{k}\\sin k\\theta$$',d:'모든 배음 · 1/k — 밝고 거친 소리(신디 기본)'},
    triangle:{f:'$$\\tfrac{8}{\\pi^2}\\sum_{k\\,odd}\\tfrac{\\pm1}{k^2}\\sin k\\theta$$',d:'홀수 배음 · 1/k² 급감 — 부드럽고 둥근 소리'}
  };
  function show(type){
    tag.textContent=type; drawWave(cv,x=>val(type,x)*0.92,{c0:'#4D7CFF',c1:'#22D3EE',glow:'#4D7CFF'});
    fEl.innerHTML=META[type].f; dEl.textContent='— '+META[type].d;
    if(window.renderMathInElement) try{renderMathInElement(fEl,kopts);}catch(e){}
  }
  document.querySelectorAll('[data-wf]').forEach(b=>b.addEventListener('click',()=>{
    stopAll(); const t=b.getAttribute('data-wf'); show(t); tone({type:t,freq:180,vol:0.22});
  }));
  drawInit.push(()=>show('sine'));
})();

/* --- 15 : instrument fingerprint --- */
(function(){
  const cv=document.getElementById('inst-spec'),tag=document.getElementById('inst-tag');
  function show(key){ tag.textContent=key+' · spectrum'; drawBars(cv,INST[key].slice()); }
  document.querySelectorAll('[data-inst]').forEach(b=>b.addEventListener('click',()=>{
    stopAll(); const k=b.getAttribute('data-inst'); show(k);
    tone({wave:periodicWave(INST[k]),freq:220,vol:0.25});
  }));
  drawInit.push(()=>show('flute'));
})();

/* --- 20 : correlation / analysis --- */
(function(){
  const topCv=document.getElementById('corr-top'),plotCv=document.getElementById('corr-plot');
  const fEl=document.getElementById('corr-f'),fR=document.getElementById('corr-f-r'),msg=document.getElementById('corr-msg');
  const f0=120, S=[1,0.7,0.5]; // harmonics 1,2,3 at 120,240,360
  function signal(t){ let s=0; for(let k=0;k<S.length;k++) s+=S[k]*Math.sin(2*Math.PI*(k+1)*f0*t); return s/2.2; }
  // detection curve over test freq
  let curve=[]; const FMIN=50,FMAX=650,STEPS=240;
  function detect(ft){
    const T=4/f0, M=900; let acc=0;
    for(let i=0;i<M;i++){const t=T*i/M; acc+=signal(t)*Math.sin(2*Math.PI*ft*t);}
    return (2/M)*acc;
  }
  function buildCurve(){ curve=[]; let mx=0; for(let i=0;i<=STEPS;i++){const ft=FMIN+(FMAX-FMIN)*i/STEPS; const d=Math.abs(detect(ft)); curve.push(d); mx=Math.max(mx,d);} curve._mx=mx||1; }
  function drawTop(ft){
    const ctx=topCv._ctx,w=topCv._w,h=topCv._h; if(!ctx)return;
    ctx.clearRect(0,0,w,h); grid(ctx,w,h); const mid=h/2, amp=h/2-14;
    const T=3/f0;
    // product as filled area
    ctx.beginPath(); const N=Math.max(360,w);
    for(let i=0;i<=N;i++){const x=i/N;const t=T*x;const p=signal(t)*Math.sin(2*Math.PI*ft*t);ctx.lineTo(x*w,mid-clamp(p,-1.2,1.2)*amp);}
    ctx.lineTo(w,mid); ctx.lineTo(0,mid); ctx.closePath();
    ctx.fillStyle='rgba(45,212,167,0.22)'; ctx.fill();
    // signal faint
    ctx.strokeStyle='rgba(255,255,255,0.28)'; ctx.lineWidth=1.4; ctx.beginPath();
    for(let i=0;i<=N;i++){const x=i/N;const t=T*x;ctx.lineTo(x*w,mid-clamp(signal(t),-1.2,1.2)*amp);} ctx.stroke();
    // test sine
    ctx.strokeStyle='rgba(124,108,240,0.85)'; ctx.lineWidth=1.4; ctx.beginPath();
    for(let i=0;i<=N;i++){const x=i/N;const t=T*x;ctx.lineTo(x*w,mid-0.55*Math.sin(2*Math.PI*ft*t)*amp);} ctx.stroke();
    // product outline glow
    ctx.strokeStyle='#2DD4A7'; ctx.lineWidth=2; ctx.shadowColor='#2DD4A7'; ctx.shadowBlur=8; ctx.beginPath();
    for(let i=0;i<=N;i++){const x=i/N;const t=T*x;const p=signal(t)*Math.sin(2*Math.PI*ft*t);ctx.lineTo(x*w,mid-clamp(p,-1.2,1.2)*amp);} ctx.stroke(); ctx.shadowBlur=0;
  }
  function drawPlot(ft){
    const ctx=plotCv._ctx,w=plotCv._w,h=plotCv._h; if(!ctx)return;
    ctx.clearRect(0,0,w,h);
    const base=h-16, pad=8;
    ctx.strokeStyle='rgba(255,255,255,0.12)'; ctx.beginPath(); ctx.moveTo(pad,base+.5);ctx.lineTo(w-pad,base+.5);ctx.stroke();
    // curve
    ctx.beginPath();
    for(let i=0;i<=STEPS;i++){const x=pad+(w-2*pad)*i/STEPS; const y=base-(curve[i]/curve._mx)*(base-10); i?ctx.lineTo(x,y):ctx.moveTo(x,y);}
    ctx.strokeStyle='rgba(120,200,255,0.5)'; ctx.lineWidth=1.6; ctx.stroke();
    // harmonic markers
    for(let k=1;k<=5;k++){ const ff=k*f0; if(ff<FMIN||ff>FMAX)continue; const x=pad+(w-2*pad)*(ff-FMIN)/(FMAX-FMIN); const u=(ff-FMIN)/(FMAX-FMIN); ctx.fillStyle=specColor(u,0.9); ctx.beginPath(); ctx.arc(x,base-(Math.abs(detect(ff))/curve._mx)*(base-10),3.5,0,7); ctx.fill(); }
    // cursor
    const cx=pad+(w-2*pad)*(ft-FMIN)/(FMAX-FMIN);
    const dv=Math.abs(detect(ft))/curve._mx;
    ctx.strokeStyle='rgba(255,255,255,0.5)'; ctx.setLineDash([3,3]); ctx.beginPath(); ctx.moveTo(cx,8);ctx.lineTo(cx,base);ctx.stroke(); ctx.setLineDash([]);
    const u=(ft-FMIN)/(FMAX-FMIN); ctx.fillStyle=specColor(u); ctx.shadowColor=specColor(u);ctx.shadowBlur=10;
    ctx.beginPath();ctx.arc(cx,base-dv*(base-10),5,0,7);ctx.fill();ctx.shadowBlur=0;
  }
  function upd(){ const ft=+fEl.value; fR.textContent='×'+(ft/f0).toFixed(2); drawTop(ft); drawPlot(ft);
    const near=Math.abs(ft-Math.round(ft/f0)*f0); const onH=Math.round(ft/f0); 
    if(near<10 && onH>=1 && onH<=3) msg.textContent='✓ '+onH+'배음과 일치 — 검출값이 솟습니다 (넓이가 한쪽으로 쌓임).';
    else msg.textContent='✗ 배음과 어긋남 — 플러스·마이너스가 상쇄돼 검출값 ≈ 0.';
  }
  fEl.addEventListener('input',upd);
  drawInit.push(()=>{buildCurve();upd();});
})();

/* --- 23 : series -> transform --- */
(function(){
  const cv=document.getElementById('s2t');
  const animBtn=document.getElementById('s2t-anim');
  let raf=0;
  function envelope(x){ const c=(x-0.5)*6; return Math.exp(-c*c); } // gaussian-ish
  function draw(density){
    const ctx=cv._ctx,w=cv._w,h=cv._h; if(!ctx)return;
    ctx.clearRect(0,0,w,h);
    const base=h-22, pad=14;
    ctx.strokeStyle='rgba(255,255,255,0.12)';ctx.beginPath();ctx.moveTo(pad,base+.5);ctx.lineTo(w-pad,base+.5);ctx.stroke();
    // envelope curve
    ctx.beginPath(); for(let i=0;i<=200;i++){const x=i/200;const px=pad+(w-2*pad)*x;const py=base-envelope(x)*(base-14);i?ctx.lineTo(px,py):ctx.moveTo(px,py);} 
    ctx.strokeStyle='rgba(250,204,21,0.35)';ctx.lineWidth=1.6;ctx.setLineDash([5,4]);ctx.stroke();ctx.setLineDash([]);
    // bars at spacing 1/density
    const n=Math.round(density); const bw=Math.max(2,(w-2*pad)/n*0.45);
    for(let i=0;i<=n;i++){const x=i/n;const px=pad+(w-2*pad)*x;const u=x;const c=specRGB(u);const bh=envelope(x)*(base-14);
      ctx.fillStyle=`rgba(${c[0]},${c[1]},${c[2]},0.92)`;ctx.shadowColor=`rgb(${c[0]},${c[1]},${c[2]})`;ctx.shadowBlur=6;
      ctx.fillRect(px-bw/2,base-bh,bw,bh);ctx.shadowBlur=0;}
    ctx.fillStyle='rgba(255,255,255,0.4)';ctx.font='10px "JetBrains Mono",monospace';ctx.textAlign='center';
    ctx.fillText(n<=8?('주기 작음 · 막대 '+ (n+1)+'개'):(n>=40?'주기 → ∞ · 연속 스펙트럼':'주기 커짐 · 막대 촘촘'),w/2,base+15);
  }
  animBtn.addEventListener('click',()=>{ cancelAnimationFrame(raf); let d=5; let last=performance.now();
    (function step(now){ if(now-last>90){ d=Math.min(60,d*1.18+1); draw(d); last=now; if(d>=60)return;} raf=requestAnimationFrame(step); })(last);
  });
  drawInit.push(()=>draw(5));
})();

/* --- 25 : spectrum analyzer (live FFT) --- */
let saRaf=0, saStopFn=null;
function saStop(){ if(saRaf){cancelAnimationFrame(saRaf);saRaf=0;} if(saStopFn){try{saStopFn();}catch(e){}saStopFn=null;} }
function saRun(kind){
  saStop(); const ctx=ac();
  const an=ctx.createAnalyser(); an.fftSize=4096; an.smoothingTimeConstant=0.82; an.connect(AU.master);
  const data=new Uint8Array(an.frequencyBinCount);
  let stop=()=>{};
  if(kind==='sweep'){
    const o=ctx.createOscillator(),g=ctx.createGain(); o.type='sawtooth'; o.connect(g); g.connect(an); g.gain.value=0.16;
    o.frequency.setValueAtTime(80,ctx.currentTime); o.frequency.exponentialRampToValueAtTime(4000,ctx.currentTime+5.5);
    o.start(); o.stop(ctx.currentTime+5.7); stop=()=>{try{o.stop();}catch(e){}};
  } else if(kind==='chord'){
    const fs=[261.63,329.63,392.0]; const os=fs.map(f=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type='sawtooth';o.frequency.value=f;g.gain.value=0.11;o.connect(g);g.connect(an);o.start();return o;});
    stop=()=>os.forEach(o=>{try{o.stop();}catch(e){}});
  } else {
    const o=ctx.createOscillator(),g=ctx.createGain(); o.setPeriodicWave(periodicWave([1,0.6,0.8,0.4,0.55,0.3,0.4,0.22,0.3,0.16])); o.frequency.value=220;g.gain.value=0.2;o.connect(g);g.connect(an);o.start();
    stop=()=>{try{o.stop();}catch(e){}};
  }
  saStopFn=stop; AU.voices.add({stop});
  const cv=document.getElementById('sa-canvas');
  const maxF=5000, sr=ctx.sampleRate, ny=an.frequencyBinCount;
  function frame(){
    an.getByteFrequencyData(data);
    const ctxc=cv._ctx,w=cv._w,h=cv._h; ctxc.clearRect(0,0,w,h);
    const base=h-20, bars=120, pad=8;
    ctxc.strokeStyle='rgba(255,255,255,0.1)';ctxc.beginPath();ctxc.moveTo(pad,base+.5);ctxc.lineTo(w-pad,base+.5);ctxc.stroke();
    const bw=(w-2*pad)/bars;
    for(let i=0;i<bars;i++){
      const f=maxF*i/bars; const bin=Math.round(f/(sr/2)*ny); const v=(data[bin]||0)/255;
      const u=f/maxF; const c=specRGB(u); const bh=v*(base-10);
      ctxc.fillStyle=`rgb(${c[0]},${c[1]},${c[2]})`; ctxc.shadowColor=`rgb(${c[0]},${c[1]},${c[2]})`;ctxc.shadowBlur=v>0.15?8:0;
      ctxc.fillRect(pad+bw*i+bw*0.1,base-bh,bw*0.8,bh);ctxc.shadowBlur=0;
    }
    ctxc.fillStyle='rgba(255,255,255,0.35)';ctxc.font='10px "JetBrains Mono",monospace';ctxc.textAlign='left';
    ctxc.fillText('0',pad,base+14); ctxc.textAlign='right'; ctxc.fillText('5 kHz',w-pad,base+14);
    saRaf=requestAnimationFrame(frame);
  }
  frame();
}
(function(){ document.querySelectorAll('[data-sa]').forEach(b=>b.addEventListener('click',()=>saRun(b.getAttribute('data-sa')))); })();

/* --- 26 : spectrogram (scrolling) --- */
let sgRaf=0, sgStopFn=null;
function sgStop(){ if(sgRaf){cancelAnimationFrame(sgRaf);sgRaf=0;} if(sgStopFn){try{sgStopFn();}catch(e){}sgStopFn=null;} }
function sgClear(){ const cv=document.getElementById('sg-canvas'); if(!cv||!cv._ctx)return; const ctx=cv._ctx; ctx.fillStyle='#05070E'; ctx.fillRect(0,0,cv._w,cv._h); }
function sgRun(kind){
  sgStop(); const ctx=ac();
  const an=ctx.createAnalyser(); an.fftSize=2048; an.smoothingTimeConstant=0.4; an.connect(AU.master);
  const data=new Uint8Array(an.frequencyBinCount);
  let stop=()=>{};
  if(kind==='melody'){
    const seq=[261.63,293.66,329.63,349.23,392,440,493.88,523.25]; const dur=0.42, t0=ctx.currentTime, os=[];
    seq.forEach((f,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.setPeriodicWave(periodicWave([1,0.5,0.3,0.18,0.1]));o.frequency.value=f;
      const st=t0+i*dur;g.gain.setValueAtTime(0,st);g.gain.linearRampToValueAtTime(0.24,st+0.02);g.gain.setTargetAtTime(0,st+dur-0.1,0.03);
      o.connect(g);g.connect(an);o.start(st);o.stop(st+dur);os.push(o);});
    stop=()=>os.forEach(o=>{try{o.stop();}catch(e){}});
  } else if(kind==='chirp'){
    const o=ctx.createOscillator(),g=ctx.createGain();o.type='sine';g.gain.value=0.22;o.connect(g);g.connect(an);
    o.frequency.setValueAtTime(160,ctx.currentTime);o.frequency.exponentialRampToValueAtTime(1500,ctx.currentTime+3.6);
    o.start();o.stop(ctx.currentTime+3.8);stop=()=>{try{o.stop();}catch(e){}};
  } else {
    const o=ctx.createOscillator(),g=ctx.createGain();o.setPeriodicWave(periodicWave([1,0.85,0.72,0.62,0.52,0.46,0.4,0.32,0.3,0.25,0.22,0.2]));o.frequency.value=180;g.gain.value=0.22;o.connect(g);g.connect(an);
    o.start();o.stop(ctx.currentTime+3.8);stop=()=>{try{o.stop();}catch(e){}};
  }
  sgStopFn=stop; AU.voices.add({stop});
  const cv=document.getElementById('sg-canvas'); const ctxc=cv._ctx, w=cv._w, h=cv._h;
  const maxF=2500, sr=ctx.sampleRate, ny=an.frequencyBinCount, step=2;
  function frame(){
    an.getByteFrequencyData(data);
    const img=ctxc.getImageData(step,0,w-step,h); ctxc.putImageData(img,0,0);
    for(let y=0;y<h;y++){
      const f=(1-y/h)*maxF; const bin=Math.round(f/(sr/2)*ny); const v=(data[bin]||0)/255;
      const u=f/maxF; const c=specRGB(u);
      ctxc.fillStyle=`rgba(${c[0]},${c[1]},${c[2]},${Math.pow(v,0.85)})`;
      ctxc.fillRect(w-step,y,step,1);
    }
    sgRaf=requestAnimationFrame(frame);
  }
  frame();
}
(function(){ document.querySelectorAll('[data-sg]').forEach(b=>b.addEventListener('click',()=>{ const k=b.getAttribute('data-sg'); if(k==='clear'){sgStop();sgClear();return;} sgRun(k); })); })();
ENTERS.spectrogram=()=>{ sgClear(); return ()=>{}; };

/* --- 29 : synth spectrum (design) --- */
(function(){
  const cv=document.getElementById('synthSpec');
  drawInit.push(()=>{
    const amps=[1,0.78,0.6,0.46,0.34,0.25,0.18,0.12,0.08,0.05];
    drawBars(cv,amps);
    const ctx=cv._ctx,w=cv._w,h=cv._h; const base=h-22,pad=10;
    ctx.strokeStyle='rgba(255,255,255,0.5)';ctx.lineWidth=1.6;ctx.setLineDash([5,4]);ctx.beginPath();
    for(let i=0;i<=80;i++){const x=i/80;const cut=0.35;const g=x<cut?1:Math.max(0,1-(x-cut)*2.4);ctx.lineTo(pad+(w-2*pad)*x,base-g*(base-12));}
    ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle='rgba(255,255,255,0.45)';ctx.font='10px "JetBrains Mono",monospace';ctx.textAlign='right';ctx.fillText('filter',w-12,18);
  });
})();

/* --- 30 : mp3 spectrum (drop inaudible) --- */
(function(){
  const cv=document.getElementById('mp3Spec');
  drawInit.push(()=>{
    const amps=[1,0.2,0.7,0.08,0.5,0.05,0.35,0.04,0.22,0.03,0.15,0.02];
    const ghost=amps.map((v,i)=>v<0.12); // drop the very weak/masked ones
    drawBars(cv,amps,{ghost});
    const ctx=cv._ctx,w=cv._w; ctx.fillStyle='rgba(251,113,133,0.8)';ctx.font='10px "JetBrains Mono",monospace';ctx.textAlign='right';ctx.fillText('버림 ✕',w-12,18);
    ctx.fillStyle='rgba(34,211,238,0.85)';ctx.textAlign='left';ctx.fillText('유지',12,18);
  });
})();

/* --- 34 : sandbox --- */
(function(){
  SB=makeBuilder({sliders:'sb-sliders',wave:'sb-wave',spec:'sb-spec',play:'sb-play',freq:220,c0:'#22D3EE',c1:'#2DD4A7',glow:'#22D3EE'});
  const rnd=document.getElementById('sb-rand');
  rnd.addEventListener('click',()=>{ const a=[]; a[0]=1; for(let k=1;k<8;k++)a[k]=Math.pow(Math.random(),1.6)*(1-k*0.06); SB.setPreset(a); });
  drawInit.push(()=>SB.update());
})();

/* ============================ INIT ============================ */
const kopts={delimiters:[{left:'$$',right:'$$',display:true},{left:'\\(',right:'\\)',display:false}],throwOnError:false};
function renderAllMath(){ if(window.renderMathInElement){ try{renderMathInElement(document.body,kopts);}catch(e){} } }

function fitAll(){
  document.querySelectorAll('canvas.viz').forEach(cv=>{
    const raw = (cv.id==='sg-canvas'); fit(cv,raw);
  });
}
function runDrawInit(){ drawInit.forEach(fn=>{try{fn();}catch(e){console.warn(e);}}); }

let resizeT=0;
window.addEventListener('resize',()=>{ clearTimeout(resizeT); resizeT=setTimeout(()=>{ fitAll(); runDrawInit(); if(cur===0)show(0); }, 160); });

function boot(){
  renderAllMath();
  fitAll();
  runDrawInit();
  show(0);
}

boot();
// fonts/late layout may shift canvas metrics — re-fit once without re-rendering math
window.addEventListener('load',()=>{ fitAll(); runDrawInit(); if(cur===0) show(0); });

})();

</script>
</body>
</html>
